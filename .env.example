# Gemini (used by the Genkit google-genai plugin for the report-classification flow)
GEMINI_API_KEY=

# Auth (Better Auth — session/account storage lives in Postgres via Prisma)
DATABASE_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# Google OAuth client (Web application type). The Client ID doubles as the
# Flutter app's GOOGLE_SERVER_CLIENT_ID dart-define — see README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
