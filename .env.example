# Gemini (used by the Genkit google-genai plugin for the report-classification flow)
GEMINI_API_KEY=

# Auth (Better Auth — session/account storage lives in Postgres via Prisma)
DATABASE_URL=
# Base URL of this deployment — Better Auth uses it to build OAuth callback
# URLs (<BETTER_AUTH_URL>/api/auth/callback/google) and set cookie
# domain/secure flags. Local dev: http://localhost:3000
# Production example: https://fixmycity-1003427733440.asia-south1.run.app
BETTER_AUTH_URL=
# Random secret Better Auth uses to sign/encrypt session cookies and CSRF
# tokens. Generate with: openssl rand -base64 32
# Unique per environment — never commit a real value or reuse dev/prod.
BETTER_AUTH_SECRET=
# Google OAuth client (Web application type). The Client ID doubles as the
# Flutter app's GOOGLE_SERVER_CLIENT_ID dart-define — see README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
