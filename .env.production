# Loaded automatically by `vite build` (Vite's own convention). Not secret —
# a Convex deployment URL is a public endpoint, safe to commit — so this
# works uniformly whether the image is built by a manual `gcloud run deploy
# --source .` or by the GitHub-connected Cloud Build trigger, neither of
# which can be relied on to pass a Docker --build-arg for it.
VITE_CONVEX_URL=https://rare-bobcat-3.convex.cloud
