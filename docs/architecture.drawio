<mxfile host="app.diagrams.net">
  <diagram name="FixMyCity Architecture" id="fixmycity-arch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== CLIENTS ===================== -->
        <mxCell id="citizen" value="Citizen&#10;Flutter Android App" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#4285F4;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;pointerEvents=1;shape=mxgraph.gcp2.phone_android;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="46" height="81" as="geometry" />
        </mxCell>

        <mxCell id="admin" value="City Staff&#10;Admin Dashboard (browser)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="40" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- ===================== CLOUD RUN: fixmycity (public) ===================== -->
        <mxCell id="orpc" value="Cloud Run — fixmycity (public)&#10;oRPC API + Better Auth" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#4285F4;strokeColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;pointerEvents=1;shape=mxgraph.gcp2.cloud_run;" vertex="1" parent="1">
          <mxGeometry x="480" y="170" width="70" height="62" as="geometry" />
        </mxCell>

        <!-- ===================== STORAGE ===================== -->
        <mxCell id="gcs" value="Cloud Storage&#10;reports/&lt;draftId&gt;.jpg" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#4285F4;strokeColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;pointerEvents=1;shape=mxgraph.gcp2.cloud_storage;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="70" height="62" as="geometry" />
        </mxCell>

        <!-- ===================== EVENTARC + PRIVATE SERVICE ===================== -->
        <mxCell id="eventarc" value="Eventarc&#10;google.cloud.storage.object.v1.finalized" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="eventsSvc" value="Cloud Run — fixmycity-events (private)&#10;/api/events/photo-uploaded" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#4285F4;strokeColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;pointerEvents=1;shape=mxgraph.gcp2.cloud_run;" vertex="1" parent="1">
          <mxGeometry x="400" y="395" width="70" height="62" as="geometry" />
        </mxCell>

        <!-- ===================== GENKIT / GEMINI ===================== -->
        <mxCell id="genkit" value="Genkit Flow — analyzeReport&#10;isCivicIssue, category, severity,&#10;description, imageIsClear" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="540" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="gemini" value="Gemini 3.6 Flash&#10;(vision + structured output + tool calling)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#4285F4;strokeColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;pointerEvents=1;shape=mxgraph.gcp2.cloud_vision_api;" vertex="1" parent="1">
          <mxGeometry x="700" y="555" width="70" height="62" as="geometry" />
        </mxCell>
        <mxCell id="tool" value="tool: findNearbyReports&#10;(model decides when to call this)" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="670" y="650" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- ===================== DATA ===================== -->
        <mxCell id="postgres" value="Cloud SQL&#10;PresubmitDraft, Ticket, User/Session" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#4285F4;strokeColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;pointerEvents=1;shape=mxgraph.gcp2.cloud_sql;" vertex="1" parent="1">
          <mxGeometry x="400" y="770" width="70" height="62" as="geometry" />
        </mxCell>

        <!-- ===================== CI/CD ===================== -->
        <mxCell id="github" value="GitHub&#10;push to main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="850" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cloudbuild" value="Cloud Build&#10;(2 triggers, auto build + deploy)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#4285F4;strokeColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;pointerEvents=1;shape=mxgraph.gcp2.container_builder;" vertex="1" parent="1">
          <mxGeometry x="1200" y="843" width="70" height="62" as="geometry" />
        </mxCell>

        <!-- ===================== EDGES: main pipeline, numbered ===================== -->
        <mxCell id="e1" value="1. create draft&#10;(photo meta, GPS)" style="html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="citizen" target="orpc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1b" value="signed upload URL" style="html=1;fontSize=10;dashed=1;strokeColor=#333333;" edge="1" parent="1" source="orpc" target="citizen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="2. upload photo" style="html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="citizen" target="gcs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="3." style="html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="gcs" target="eventarc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3b" value="" style="html=1;strokeColor=#333333;" edge="1" parent="1" source="eventarc" target="eventsSvc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="4. run pipeline" style="html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="eventsSvc" target="genkit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="classify + score" style="html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="genkit" target="gemini">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="" style="html=1;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="gemini" target="tool">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="within 150m, same category" style="html=1;fontSize=9;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="tool" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="5. mark draft ready" style="html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="eventsSvc" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="6. review, edit, approve" style="html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="orpc" target="citizen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="create ticket" style="html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="orpc" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="poll every 5s" style="html=1;fontSize=10;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="admin" target="orpc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="" style="html=1;strokeColor=#666666;" edge="1" parent="1" source="github" target="cloudbuild">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="deploy" style="html=1;fontSize=9;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="cloudbuild" target="orpc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="deploy" style="html=1;fontSize=9;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="cloudbuild" target="eventsSvc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
